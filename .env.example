# ConnectHub Environment Configuration

MONGODB_URI=mongodb://localhost:27017/?directConnection=true
PORT=5000

# ------------------------------------------------------------------------------
# GOOGLE DRIVE REAL-TIME BACKUP CONFIGURATION
# ------------------------------------------------------------------------------
# To connect real-time backups to your Google Drive:
# 1. Go to Google Cloud Console (https://console.cloud.google.com/)
# 2. Create a project & enable "Google Drive API".
# 3. Create a Service Account (Credentials -> Create Credentials -> Service Account).
# 4. Generate a JSON Key for the Service Account and download it.
# 5. Paste the client_email and private_key below.
# 6. (Optional) Create a folder in Google Drive, share it with the Service Account email (Editor permissions),
#    and paste its Folder ID below (from the URL: drive.google.com/drive/folders/YOUR_FOLDER_ID).
# ------------------------------------------------------------------------------

GOOGLE_SERVICE_ACCOUNT_EMAIL=https://script.google.com/macros/s/AKfycbwVlOUbr6gyVf9hDCRY4ybxpv3BZprwOecap-nQeaJJzQSsawfsto5PE1abfHsLOuN9/exec

